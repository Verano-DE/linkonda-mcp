{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": [
    "test/**/*",
    "vitest.config.ts",
    "../raycast/src/**/*",
    "../raycast/raycast-env.d.ts"
  ],
  "compilerOptions": {
    "lib": [
      "es2023"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2023",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  }
}
